{
  "name": "nexrun",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env --import tsx --test apps/api/test/*.test.ts scripts/license-gate.test.mjs",
    "test:e2e": "playwright test",
    "test:pi": "RUN_PI_SMOKE=1 node --env-file-if-exists=.env --import tsx scripts/pi-smoke.ts",
    "db:migrate": "npm run db:migrate --workspace @nexrun/api",
    "licenses:review": "node scripts/licenses.mjs review",
    "licenses:check": "node scripts/licenses.mjs check",
    "check": "npm run typecheck && npm run lint && npm run licenses:check && npm test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "eslint": "10.14.0",
    "rollup": "4.43.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "rollup": "4.43.0"
  }
}
