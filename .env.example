DATABASE_URL=postgres://nexrun:nexrun@127.0.0.1:55439/nexrun
API_HOST=127.0.0.1
API_PORT=3001
AGENT_MODE=mock
PI_PROVIDER=openai
PI_MODEL=gpt-5-mini
AGENT_RESPONSE_LANGUAGE=auto
PI_STATE_DIR=../../.data/pi
# Environment fallback keys; credentials can also be saved in Settings. Never commit real keys.
# NEXRUN_OPENAI_API_KEY=
# OPENAI_API_KEY=
# Optional admin protection for shared deployments. Use a long random token.
# NEXRUN_ADMIN_TOKEN=
# Optional stable base64-encoded 32-byte encryption key; otherwise private server state stores one.
# NEXRUN_CONFIG_ENCRYPTION_KEY=
GENERATION_TIMEOUT_MS=60000
MAX_CONCURRENT_RUNS=2
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost
