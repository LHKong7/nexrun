{
  "name": "@nexrun/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "demo:seed": "node --env-file-if-exists=../../.env --import tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@nexrun/protocol": "0.0.0",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "@earendil-works/pi-coding-agent": "1.5.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
